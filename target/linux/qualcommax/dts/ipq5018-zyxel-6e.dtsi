#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	aliases {
		serial0 = &blsp1_uart1;
		label-mac-device = &gmac1;
		led-boot = &led_status_blue;
		led-failsafe = &led_status_white;
		led-running = &led_status_green;
		led-upgrade = &led_status_red;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&tsens {
	status = "okay";
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&gmac0 {
	status = "okay";

	label = "lan1";

	nvmem-cells = <&label_mac 1>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";

	phy-handle = <&qca8081>;
	phy-mode = "2500base-x";

	label = "uplink";

	nvmem-cells = <&label_mac 0>;
	nvmem-cell-names = "mac-address";
};

&mdio0 {
	status = "okay";

	/* route the internal GE PHY LED signals to the port LEDs */
	pinctrl-0 = <&ge_phy_led_pins>;
	pinctrl-names = "default";
};

&ge_phy {
	leds {
		#address-cells = <1>;
		#size-cells = <0>;

		/* 1G link/activity */
		led@0 {
			reg = <0>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			default-state = "keep";
		};

		/* 10/100 link/activity */
		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_LAN;
			default-state = "keep";
		};
	};
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	qca8081: ethernet-phy@16 {
		compatible = "ethernet-phy-id004d.d101";
		reg = <16>;
		reset-deassert-us = <10000>;
		reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			/* 2.5G link/activity */
			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_LAN;
				default-state = "keep";
			};

			/* 10/100/1000 link/activity */
			led@2 {
				reg = <2>;
				color = <LED_COLOR_ID_AMBER>;
				function = LED_FUNCTION_LAN;
				default-state = "keep";
			};
		};
	};
};

&blsp1_spi1 {
	status = "okay";

	flash@0 {
		reg = <0>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:sbl1";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "0:mibib";
				reg = <0x030000 0x010000>;
				read-only;
			};

			partition@40000 {
				label = "0:bootconfig";
				reg = <0x040000 0x010000>;
			};

			partition@50000 {
				label = "0:bootconfig1";
				reg = <0x050000 0x010000>;
			};

			partition@60000 {
				label = "0:qsee";
				reg = <0x060000 0x0a0000>;
				read-only;
			};

			partition@100000 {
				label = "0:qsee_1";
				reg = <0x100000 0x0a0000>;
				read-only;
			};

			partition@1a0000 {
				label = "0:devcfg";
				reg = <0x1a0000 0x010000>;
				read-only;
			};

			partition@1b0000 {
				label = "0:devcfg_1";
				reg = <0x1b0000 0x010000>;
				read-only;
			};

			partition@1c0000 {
				label = "0:cdt";
				reg = <0x1c0000 0x010000>;
				read-only;
			};

			partition@1d0000 {
				label = "0:cdt_1";
				reg = <0x1d0000 0x010000>;
				read-only;
			};

			partition@1e0000 {
				label = "0:appsblenv";
				reg = <0x1e0000 0x010000>;
			};

			partition@1f0000 {
				label = "0:appsbl";
				reg = <0x1f0000 0x0a0000>;
				read-only;
			};

			partition@290000 {
				label = "0:appsbl_1";
				reg = <0x290000 0x0a0000>;
				read-only;
			};

			partition@330000 {
				label = "0:art";
				reg = <0x330000 0x070000>;
				read-only;
			};

			partition@3a0000 {
				label = "mrd";
				reg = <0x3a0000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					label_mac: macaddr@fff8 {
						compatible = "mac-base";
						reg = <0xfff8 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@3b0000 {
				label = "mrd_1";
				reg = <0x3b0000 0x010000>;
				read-only;
			};

			partition@3c0000 {
				label = "reserved";
				reg = <0x3c0000 0x440000>;
				read-only;
			};
		};
	};
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:training";
				reg = <0x0000000 0x0080000>;
				read-only;
			};

			/* image0: U-Boot always passes ubi.mtd=rootfs */
			partition@80000 {
				label = "rootfs";
				reg = <0x0080000 0x3e00000>;
				linux,rootfs;
			};

			/* image1 */
			partition@3e80000 {
				label = "rootfs_1";
				reg = <0x3e80000 0x3e00000>;
			};

			partition@7c80000 {
				label = "zyxel_rootfs_data";
				reg = <0x7c80000 0x3c00000>;
				read-only;
			};

			partition@b880000 {
				label = "myzyxel";
				reg = <0xb880000 0x0f00000>;
				read-only;
			};

			partition@c780000 {
				label = "logs";
				reg = <0xc780000 0x3880000>;
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio23";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ge_phy_led_pins: ge-phy-led-state {
		led0-pins {
			pins = "gpio46";
			function = "led0";
			drive-strength = <8>;
			bias-pull-down;
		};

		led2-pins {
			pins = "gpio30";
			function = "led2";
			drive-strength = <8>;
			bias-pull-down;
		};
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};

	/* MR input of the board reset supervisor, low resets the board */
	rst-mb-hog {
		gpio-hog;
		gpios = <27 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "rst-mb";
	};
};

&pcie0_phy {
	status = "okay";
};

&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		pcie_wifi: wifi@0,0 {
			status = "okay";

			/* QCN9074: ath11k lacks DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,ath11k-fw-memory-mode = <0>;
		};
	};
};
